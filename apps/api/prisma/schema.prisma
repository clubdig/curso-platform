generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String
  role          String    @default("STUDENT")
  avatarUrl     String?   @map("avatar_url")
  phone         String?
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  courses       Course[]
  orders        Order[]
  enrollments   Enrollment[]
  comments      Comment[]
  certificates  Certificate[]
  subscriptions Subscription[]
  affiliate     Affiliate?
  lessonProgresses LessonProgress[]

  @@map("users")
}

model Course {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String?
  shortDescription String? @map("short_description")
  coverUrl        String?  @map("cover_url")
  price           Decimal  @db.Decimal(10, 2)
  salePrice       Decimal? @db.Decimal(10, 2) @map("sale_price")
  type            String   @default("ONE_TIME")
  accessDuration  Int?     @map("access_duration")
  status          String   @default("DRAFT")
  producerId      String   @map("producer_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  producer        User          @relation(fields: [producerId], references: [id])
  modules         CourseModule[]
  enrollments     Enrollment[]
  orderItems      OrderItem[]
  coupons         Coupon[]
  certificates    Certificate[]
  subscriptions   Subscription[]

  @@map("courses")
}

model CourseModule {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int
  courseId     String   @map("course_id")
  createdAt   DateTime @default(now()) @map("created_at")

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([courseId, order])
  @@map("course_modules")
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("VIDEO")
  contentUrl  String?  @map("content_url")
  duration    Int?
  order       Int
  isFree      Boolean  @default(false) @map("is_free")
  dripDays    Int?     @map("drip_days")
  moduleId    String   @map("module_id")
  createdAt   DateTime @default(now()) @map("created_at")

  module      CourseModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  comments    Comment[]

  @@unique([moduleId, order])
  @@map("lessons")
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  lessonId    String    @map("lesson_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  watchTime   Int       @default(0) @map("watch_time")

  user        User      @relation(fields: [userId], references: [id])
  lesson      Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model Enrollment {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  courseId         String   @map("course_id")
  orderId         String?  @map("order_id")
  status          String   @default("ACTIVE")
  accessExpiresAt DateTime? @map("access_expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  user            User     @relation(fields: [userId], references: [id])
  course          Course   @relation(fields: [courseId], references: [id])
  order           Order?   @relation(fields: [orderId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Order {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  total       Decimal  @db.Decimal(10, 2)
  status      String   @default("PENDING")
  couponId    String?  @map("coupon_id")
  affiliateId String?  @map("affiliate_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  coupon      Coupon?     @relation(fields: [couponId], references: [id])
  enrollments Enrollment[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  courseId   String  @map("course_id")
  price     Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course    Course  @relation(fields: [courseId], references: [id])

  @@map("order_items")
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  amount          Decimal  @db.Decimal(10, 2)
  method          String
  status          String   @default("PENDING")
  gatewayId       String?  @map("gateway_id")
  gatewayResponse Json?    @map("gateway_response")
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime @default(now()) @map("created_at")

  order           Order    @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Subscription {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  courseId              String   @map("course_id")
  gatewaySubscriptionId String   @map("gateway_subscription_id")
  status                String   @default("ACTIVE")
  currentPeriodStart    DateTime @map("current_period_start")
  currentPeriodEnd      DateTime @map("current_period_end")
  cancelAt              DateTime? @map("cancel_at")
  createdAt             DateTime @default(now()) @map("created_at")

  user                  User     @relation(fields: [userId], references: [id])
  course                Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("subscriptions")
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String
  value     Decimal   @db.Decimal(10, 2)
  maxUses   Int?      @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")
  courseId   String?  @map("course_id")
  createdAt DateTime  @default(now()) @map("created_at")

  course    Course?   @relation(fields: [courseId], references: [id])
  orders    Order[]

  @@map("coupons")
}

model Certificate {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  courseId           String   @map("course_id")
  certificateNumber String   @unique @map("certificate_number")
  issuedAt          DateTime @default(now()) @map("issued_at")
  pdfUrl            String?  @map("pdf_url")

  user              User     @relation(fields: [userId], references: [id])
  course            Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("certificates")
}

model Comment {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  content   String
  status    String   @default("PENDING")
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")

  @@map("comments")
}

model Affiliate {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  commissionRate Decimal  @db.Decimal(5, 2) @map("commission_rate")
  totalEarnings  Decimal  @db.Decimal(10, 2) @default(0) @map("total_earnings")
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id])

  @@map("affiliates")
}

model WebhookLog {
  id        String   @id @default(cuid())
  event     String
  payload   Json
  status    Int
  response  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("webhook_logs")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
